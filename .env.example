# Copy this file to .env.local and fill in what you need. Everything is optional.
# On the live site, set these in Vercel → Project → Settings → Environment Variables.

# Your live address, used for sitemap, canonical links, share links and social previews (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Leave empty to disable tracking.
NEXT_PUBLIC_GA4_ID=

# Form delivery (border corrections, classroom notes, update sign-ups).
# Without these, submissions are saved to data/submissions.json (local only; on Vercel it's temporary).
# Option A: send each submission to a webhook (Zapier, Make, Google Apps Script, Slack...)
SUBMISSIONS_WEBHOOK_URL=
# Option B: email each submission with Resend (resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=you@example.com
NOTIFY_EMAIL_FROM=Scale Shift <forms@your-domain.com>
# Optional: custom path for the local JSON file
SUBMISSIONS_FILE=

# Daily challenge leaderboard.
# Without these, scores are saved to data/leaderboard.json (fine on your computer).
# On Vercel you NEED Redis or scores get wiped: Vercel → Storage → Upstash Redis (fills in KV_REST_API_URL / KV_REST_API_TOKEN),
# or create a free database at upstash.com and paste its REST URL and token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signs the one-click unsubscribe links in reminder emails. Any long random string; keep it secret.
# Without it the Redis token is used, which also works but changes if you ever rotate that token.
UNSUBSCRIBE_SECRET=

# Leaderboard sign-in (Clerk). Leave empty to keep the old "type your email" sign-up.
# On Vercel these are added for you by Marketplace → Clerk. Never commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
