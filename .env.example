# Copy this file to .env.local and fill in what you need. Everything is optional.

# Your live address, used for sitemap, canonical links and share images (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Leave empty to disable tracking.
NEXT_PUBLIC_GA4_ID=

# Form delivery. Without these, submissions are saved to data/submissions.json (local only).
# Option A: send each submission to a webhook (Zapier, Make, GoHighLevel, Google Apps Script...)
SUBMISSIONS_WEBHOOK_URL=
# Option B: email each submission with Resend (resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=you@example.com
NOTIFY_EMAIL_FROM=Scale Shift <forms@your-domain.com>
# Optional: custom path for the local JSON file
SUBMISSIONS_FILE=
